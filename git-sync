#!/usr/bin/env bash
# git-sync: copy a repo's full history (all branches and tags) to another repo, and keep it in sync.
# Works between any git hosts. Re-running only transfers what changed.
#
# Usage:
#   git-sync [options] <source-url> <dest-url>
#   git-sync [options] -f <pairs-file>
#
# Pairs file: one pair per line, "# comments" and blank lines ignored:
#   <source-url> <dest-url> [src_key=PATH] [dst_key=PATH] [src_token_env=VAR] [dst_token_env=VAR] [src_user=U] [dst_user=U] [dst_api_user=U] [dst_prefix=P]
#   key = SSH private key file. token_env = NAME of an env var holding an HTTPS token (the file never holds secrets).
#   user = HTTPS user name for git (default x-access-token; x-token-auth on bitbucket.org).
#   dst_prefix = see --dst-prefix, for this pair only (empty = none).
#   dst_api_user = Bitbucket only: the account email, when the token is an API token; without it the token is a Bearer access token.
#                  An API token also needs dst_user=x-bitbucket-api-token-auth (the name comes from third-party docs, unconfirmed).
#
# Options:
#   --dry-run   fetch the source and simulate the push; changes nothing at the destination
#               (with --create and a missing destination it only checks that the repo can be created)
#   --force     allow a non-empty destination on the first run, and non-fast-forward updates
#   --prune     delete branches/tags at the destination that no longer exist at the source
#   --create    create the destination repo if it doesn't exist (private); GitHub via `gh`, Azure DevOps via `az`,
#               gitlab.com and bitbucket.org via their APIs (need a token: --dst-token-env or dst_token_env=)
#   --public    with --create, make the new repo public (refused on Azure DevOps, where the project sets it)
#   --skip-merged  leave out branches already merged into the source's default branch (their commits stay in that branch);
#               tags are always copied. With --prune, such branches already at the destination are deleted
#   --dst-prefix P  land branches as P/<branch> and tags as P/<tag> at the destination, so several sources can share one
#               destination repo; the first-sync check, --prune and the verification only look at refs under P/
#   --src-key P / --dst-key P / --src-token-env V / --dst-token-env V   default credentials for all pairs
#
# Env: GIT_SYNC_DIR (cache, default ~/.cache/git-sync), GIT_SYNC_{SRC,DST}_{KEY,TOKEN_ENV,USER}, GIT_SYNC_DST_API_USER and GIT_SYNC_DST_PREFIX as defaults.
# Exit: 0 all pairs ok, 1 at least one pair failed, 2 bad usage.
set -uo pipefail
export GIT_TERMINAL_PROMPT=0

usage() { sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

dry=0; force=0; prune=0; skip_merged=0; create=0; visibility=private; file=
D_SRC_KEY=${GIT_SYNC_SRC_KEY:-};  D_DST_KEY=${GIT_SYNC_DST_KEY:-}
D_SRC_TOKEN_ENV=${GIT_SYNC_SRC_TOKEN_ENV:-}; D_DST_TOKEN_ENV=${GIT_SYNC_DST_TOKEN_ENV:-}
D_SRC_USER=${GIT_SYNC_SRC_USER:-}; D_DST_USER=${GIT_SYNC_DST_USER:-}
D_DST_API_USER=${GIT_SYNC_DST_API_USER:-}; D_DST_PREFIX=${GIT_SYNC_DST_PREFIX:-}
while [[ ${1:-} == -* ]]; do
  case $1 in
    --dry-run) dry=1;; --force) force=1;; --prune) prune=1;; --skip-merged) skip_merged=1;; --create) create=1;; --public) visibility=public;;
    -f) file=${2:-}; shift;;
    --src-key) D_SRC_KEY=${2:-}; shift;; --dst-key) D_DST_KEY=${2:-}; shift;;
    --src-token-env) D_SRC_TOKEN_ENV=${2:-}; shift;; --dst-token-env) D_DST_TOKEN_ENV=${2:-}; shift;; --dst-prefix) D_DST_PREFIX=${2:-}; shift;;
    *) usage;;
  esac; shift
done
if [[ -n $file ]]; then [[ $# -eq 0 && -f $file ]] || usage; else [[ $# -eq 2 ]] || usage; fi

# bad_prefix <prefix>: succeeds, and says why on stderr, when the prefix can't head a branch or tag name.
bad_prefix() {
  [[ -z $1 ]] && return 1
  [[ $1 != -* ]] && git check-ref-format "refs/heads/$1/x" && git check-ref-format "refs/tags/$1/x" && return 1
  echo "invalid prefix '$1': it must work as a branch and tag name prefix (no leading or trailing slash, '..', spaces, ...)" >&2
  return 0
}
bad_prefix "$D_DST_PREFIX" && exit 2

cache_root=${GIT_SYNC_DIR:-$HOME/.cache/git-sync}
mkdir -p "$cache_root" || exit 1

# gitc <SRC|DST> <git args...>: run git with that side's credentials.
gitc() {
  local side=$1; shift
  local k=${side}_KEY t=${side}_TOKEN_ENV u=${side}_USER
  local -a pre=()
  if [[ -n ${!t:-} ]]; then
    pre=(-c credential.helper= -c "credential.helper=!f() { echo username=${!u}; echo \"password=\$${!t}\"; }; f")
  fi
  if [[ -n ${!k:-} ]]; then
    GIT_SSH_COMMAND="ssh -i ${!k} -o IdentitiesOnly=yes -o BatchMode=yes" git ${pre[@]+"${pre[@]}"} "$@"
  else
    git ${pre[@]+"${pre[@]}"} "$@"
  fi
}

parse_url() {
  local u=$1
  if [[ $u == *://* ]]; then
    u=${u#*://}; u=${u#*@}; url_host=${u%%/*}; url_host=${url_host%%:*}; url_path=${u#*/}
  else
    u=${u#*@}; url_host=${u%%:*}; url_path=${u#*:}
  fi
  url_path=${url_path#/}; url_path=${url_path%/}; url_path=${url_path%.git}
}

gh_dst() {
  ( export GH_HOST=github.com
    if [[ -n ${DST_TOKEN_ENV:-} ]]; then export GH_TOKEN=${!DST_TOKEN_ENV:-}; fi
    gh "$@" </dev/null )
}

dst_token_ok() {
  if [[ -n ${DST_TOKEN_ENV:-} && -z ${!DST_TOKEN_ENV:-} ]]; then
    echo "env var $DST_TOKEN_ENV is empty; the CLI would fall back to its own login and could create the repo in the wrong account" >&2
    return 1
  fi
}

# Returns 2 when the repo already exists, so a failed git read of it is an access problem, not a missing repo.
create_github() {
  command -v gh >/dev/null || { echo "gh is not installed" >&2; return 1; }
  [[ $1 == */* && $1 != */*/* ]] || { echo "cannot read owner/name from the URL" >&2; return 1; }
  dst_token_ok || return 1
  local err
  if err=$(gh_dst repo view "$1" 2>&1 >/dev/null); then return 2; fi
  [[ $err == *"Could not resolve to a Repository"* ]] ||
    { echo "gh could not check the repo (not logged in, bad token or no network)" >&2; return 1; }
  [[ $2 == check ]] && return 0
  gh_dst repo create "$1" "--$visibility" >/dev/null || return 1
}

az_dst() {
  ( if [[ -n ${DST_TOKEN_ENV:-} ]]; then export AZURE_DEVOPS_EXT_PAT=${!DST_TOKEN_ENV:-}; fi
    az "$@" </dev/null )
}

# Not printf %b on the whole string: that would also expand backslashes and choke on a lone %.
url_decode() {
  local s=$1 out= re='^([^%]*)%([0-9A-Fa-f]{2})(.*)$'
  while [[ $s =~ $re ]]; do
    out+=${BASH_REMATCH[1]}$(printf "\\x${BASH_REMATCH[2]}")
    s=${BASH_REMATCH[3]}
  done
  printf '%s' "$out$s"
}

# Same contract as create_github. Azure repos have no visibility of their own: it comes from the project.
create_azure() {
  command -v az >/dev/null || { echo "az is not installed" >&2; return 1; }
  [[ $visibility != public ]] || { echo "Azure DevOps repos follow the project's visibility; --public is not supported" >&2; return 1; }
  dst_token_ok || return 1
  local -a p; IFS=/ read -r -a p <<< "$1"
  local org proj repo
  if [[ ${#p[@]} -eq 4 && ${p[2]} == _git ]]; then org=${p[0]} proj=${p[1]} repo=${p[3]}
  elif [[ ${#p[@]} -eq 3 && ${p[1]} == _git ]]; then org=${p[0]} proj=${p[2]} repo=${p[2]}
  elif [[ ${#p[@]} -eq 4 && ${p[0]} == v3 ]]; then org=${p[1]} proj=${p[2]} repo=${p[3]}
  else echo "cannot read organization, project and repo from the URL" >&2; return 1; fi
  proj=$(url_decode "$proj"); repo=$(url_decode "$repo")
  visibility_note="set by the project"
  local orgurl=https://dev.azure.com/$org err
  if err=$(az_dst repos show --repository "$repo" --project "$proj" --organization "$orgurl" -o none 2>&1); then return 2; fi
  [[ $err != *TF200016* ]] ||
    { echo "Azure DevOps project '$proj' does not exist or is not visible to this login; --create makes repos, not projects, so the project must exist already" >&2; return 1; }
  [[ $err == *TF401019* ]] ||
    { echo "az could not check the repo (azure-devops extension missing, not logged in or bad PAT)" >&2; return 1; }
  [[ $2 == check ]] && return 0
  az_dst repos create --name "$repo" --project "$proj" --organization "$orgurl" -o none || return 1
}

# http_dst <auth-fn> <method> <url> [json]: curl with the credentials read from stdin, so no secret is ever on a command
# line. Sets http_code and http_body; http_code is 000 when curl itself failed.
http_dst() {
  local auth=$1 method=$2 url=$3 data=${4:-} out
  out=$( { "$auth"; printf 'url = "%s"\nrequest = "%s"\n' "$url" "$method"
           if [[ -n $data ]]; then
             printf 'header = "Content-Type: application/json"\n'
             data=${data//\\/\\\\}; printf 'data = "%s"\n' "${data//\"/\\\"}"
           fi
         } | curl -q -sS -m 30 -K - -w '\n%{http_code}' 2>/dev/null )
  http_code=${out##*$'\n'}; http_body=${out%$'\n'*}
  [[ $http_code =~ ^[0-9]{3}$ ]] || { http_code=000; http_body=; }
}

# http_fail <Provider> <what was being done>: the status and the start of the provider's own message (no secrets in it).
http_fail() {
  if [[ $http_code == 000 ]]; then echo "could not reach $1 while $2 (no network, curl failed or timed out; if this was the create call it may still have gone through, so rerun)" >&2
  else echo "$1 answered $http_code while $2: $(printf '%s' "$http_body" | head -c 200)" >&2; fi
  return 1
}

need_curl() { command -v curl >/dev/null || { echo "curl is not installed" >&2; return 1; }; }

dst_token_required() {
  [[ -n ${DST_TOKEN_ENV:-} && -n ${!DST_TOKEN_ENV:-} ]] ||
    { echo "--create on $1 needs a token: set --dst-token-env (or dst_token_env=) to a variable holding one" >&2; return 1; }
}

gitlab_auth() { printf 'header = "PRIVATE-TOKEN: %s"\n' "${!DST_TOKEN_ENV}"; }

# Same contract as create_github. Needs a token with the api scope in the DST_TOKEN_ENV variable.
create_gitlab() {
  [[ $1 == */* ]] || { echo "cannot read group/project from the URL" >&2; return 1; }
  [[ $1 =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+$ && /$1/ != */./* && /$1/ != */../* ]] ||
    { echo "GitLab paths may only use letters, digits, '_', '-' and '.'" >&2; return 1; }
  need_curl && dst_token_required GitLab || return 1
  local api=https://gitlab.com/api/v4 ns=${1%/*} name=${1##*/}
  http_dst gitlab_auth GET "$api/projects/${1//\//%2F}"
  case $http_code in
    200) return 2;;
    404) ;;
    *) http_fail GitLab "checking the repo (bad token or scope, rate limit or outage)"; return 1;;
  esac
  http_dst gitlab_auth GET "$api/namespaces/${ns//\//%2F}"
  local nsid; nsid=$(printf '%s' "$http_body" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
  [[ $http_code == 200 && -n $nsid ]] ||
    { echo "GitLab group or user '$ns' not found or not visible to the token (HTTP $http_code)" >&2; return 1; }
  [[ $2 == check ]] && return 0
  http_dst gitlab_auth POST "$api/projects" "{\"name\":\"$name\",\"path\":\"$name\",\"namespace_id\":$nsid,\"visibility\":\"$visibility\"}"
  [[ $http_body != *"has already been taken"* ]] ||
    { echo "GitLab says that name or path is already taken: a project the token cannot see, or a group with that path" >&2; return 1; }
  [[ $http_code == 201 ]] || http_fail GitLab "creating the repo"
}

# App passwords were removed in 2026. An API token logs into the API as the account email but into git over HTTPS
# as another user name, so the API identity and the git user name are separate settings.
bitbucket_auth() {
  if [[ -n ${DST_API_USER:-} ]]; then printf 'user = "%s:%s"\n' "$DST_API_USER" "${!DST_TOKEN_ENV}"
  else printf 'header = "Authorization: Bearer %s"\n' "${!DST_TOKEN_ENV}"; fi
}

# Same contract as create_github. Bitbucket puts a new repo in the workspace's oldest project.
create_bitbucket() {
  [[ $1 =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && /$1/ != */./* && /$1/ != */../* ]] ||
    { echo "Bitbucket paths must be workspace/repo, using only letters, digits, '_', '-' and '.'" >&2; return 1; }
  need_curl && dst_token_required Bitbucket || return 1
  local url=https://api.bitbucket.org/2.0/repositories/$1 private=true
  http_dst bitbucket_auth GET "$url"
  case $http_code in
    200) return 2;;
    404) ;;
    *) http_fail Bitbucket "checking the repo (bad token or scope, rate limit or outage)"; return 1;;
  esac
  [[ $2 == check ]] && return 0
  [[ $visibility == public ]] && private=false
  http_dst bitbucket_auth POST "$url" "{\"scm\":\"git\",\"is_private\":$private}"
  [[ $http_code != 404 ]] ||
    { echo "Bitbucket workspace '${1%/*}' not found or not visible to the token, or the token cannot create repos there" >&2; return 1; }
  [[ $http_code == 200 || $http_code == 201 ]] || http_fail Bitbucket "creating the repo"
}

create_dest() {
  parse_url "$1"
  local host; host=$(ssh -G "$url_host" 2>/dev/null | awk '$1=="hostname"{print $2; exit}')
  case ${host:-$url_host} in
    github.com|ssh.github.com) create_github "$url_path" "$2";;
    dev.azure.com|ssh.dev.azure.com) create_azure "$url_path" "$2";;
    gitlab.com|altssh.gitlab.com) create_gitlab "$url_path" "$2";;
    bitbucket.org|altssh.bitbucket.org) create_bitbucket "$url_path" "$2";;
    *) echo "--create does not support host '${host:-$url_host}' yet" >&2; return 1;;
  esac
}

# refs <SRC|DST> <url>: sorted "sha ref" lines for heads and tags, without peeled entries.
refs() {
  local out; out=$(gitc "$1" ls-remote --heads --tags "$2") || return 1
  [[ -z $out ]] || printf '%s
' "$out" | grep -v '\^{}$' | sort -k2
  return 0
}

add_prefix() {
  awk -F'\t' -v p="$1" '{ r = $2; if (index(r, "refs/heads/") == 1) r = "refs/heads/" p "/" substr(r, 12); else r = "refs/tags/" p "/" substr(r, 11); print $1 "\t" r }'
}

under_prefix() {
  awk -F'\t' -v h="refs/heads/$1/" -v t="refs/tags/$1/" 'index($2, h) == 1 || index($2, t) == 1'
}

# prefix_clashes <prefix>: prints the "sha<TAB>ref" lines read from stdin that can't coexist with refs under the prefix
# (a branch or tag named like the prefix, or like a leading part of it).
prefix_clashes() {
  awk -F'\t' -v p="$1" 'function clash(k) { return index($2, k) == 1 && index(k p "/", $2 "/") == 1 }
    clash("refs/heads/") || clash("refs/tags/")'
}

sync_one() {
  local src=$1 dst=$2 name; name=$(basename "$src"); name=${name%.git}
  local pfx=$DST_PREFIX; [[ -z $pfx ]] || name="$name ($pfx/)"
  local id; id=$( { printf '%s\n%s' "$src" "$dst"; [[ -z $pfx ]] || printf '\n%s' "$pfx"; } | { shasum 2>/dev/null || sha1sum; } | cut -c1-12)
  local cache=$cache_root/$id.git first=0
  [[ -d $cache ]] || first=1

  local srcrefs dstrefs
  srcrefs=$(refs SRC "$src") || { echo "FAIL $name: cannot read source (auth, URL or network)" >&2; return 1; }
  [[ -n $(printf '%s\n' "$srcrefs" | grep 'refs/heads/') ]] ||
    { echo "FAIL $name: source has no branches; refusing to continue" >&2; return 1; }
  if ! dstrefs=$(refs DST "$dst"); then
    if (( create )); then
      visibility_note=$visibility; create_dest "$dst" check; local rc=$?
      (( rc == 2 )) && { echo "FAIL $name: destination exists but cannot be read (auth)" >&2; return 1; }
      (( rc == 0 )) || { echo "FAIL $name: cannot create destination" >&2; return 1; }
      if (( dry )); then echo "ok   $name (dry run: destination missing, would create it, visibility: $visibility_note)"; return 0; fi
      create_dest "$dst" create || { echo "FAIL $name: could not create destination" >&2; return 1; }
      dstrefs=$(refs DST "$dst") || { echo "FAIL $name: created destination but cannot read it (auth)" >&2; return 1; }
    else
      echo "FAIL $name: cannot read destination (auth, URL or repo missing; --create makes a missing one)" >&2; return 1
    fi
  fi
  local dstown=$dstrefs
  if [[ -n $pfx ]]; then
    local clash; clash=$(printf '%s\n' "$dstrefs" | prefix_clashes "$pfx" | cut -f2)
    if [[ -n $clash ]]; then
      echo "FAIL $name: the destination has $(printf '%s' "$clash" | tr '\n' ' ')which clashes with the prefix '$pfx'; pick another prefix or remove that ref" >&2
      return 1
    fi
    dstown=$(printf '%s\n' "$dstrefs" | under_prefix "$pfx")
  fi
  if (( first && force == 0 )) && [[ -n $dstown ]]; then
    echo "FAIL $name: destination already has refs and this pair was never synced here; rerun with --force to adopt it" >&2
    return 1
  fi

  (( first )) && { git init --bare -q "$cache" || return 1; git -C "$cache" config gc.auto 0; }

  gitc SRC -C "$cache" fetch -q --no-tags --prune "$src" \
    '+refs/heads/*:refs/heads/*' '+refs/tags/*:refs/tags/*' ||
    { echo "FAIL $name: fetch failed" >&2; return 1; }

  local skipped=
  if (( skip_merged )); then
    local def; def=$(gitc SRC ls-remote --symref "$src" HEAD | awk '$1 == "ref:" { sub("refs/heads/", "", $2); print $2 }')
    git -C "$cache" show-ref --verify -q "refs/heads/$def" ||
      { echo "FAIL $name: --skip-merged needs the source's default branch and could not find it (HEAD: '${def:-none}')" >&2; return 1; }
    skipped=$(git -C "$cache" for-each-ref --merged="refs/heads/$def" --format='%(refname)' refs/heads/ | grep -vFx "refs/heads/$def")
    [[ -z $skipped ]] || printf 'delete %s\n' $skipped | git -C "$cache" update-ref --stdin ||
      { echo "FAIL $name: could not drop merged branches from the cache" >&2; return 1; }
  fi

  local -a flags=()
  (( force )) && flags+=(--force); (( prune )) && flags+=(--prune); (( dry )) && flags+=(--dry-run)
  local to=; [[ -z $pfx ]] || to=$pfx/
  gitc DST -C "$cache" push -q ${flags[@]+"${flags[@]}"} "$dst" \
    "refs/heads/*:refs/heads/$to*" "refs/tags/*:refs/tags/$to*" ||
    { echo "FAIL $name: push failed (rejected refs need --force; read-only credentials also land here)" >&2; return 1; }

  if (( dry )); then echo "ok   $name (dry run: fetched, push simulated, nothing changed)"; return 0; fi

  local after missing
  after=$(refs DST "$dst") || { echo "FAIL $name: pushed, but could not re-read destination to verify" >&2; return 1; }
  local kept=$srcrefs
  [[ -z $skipped ]] || kept=$(printf '%s\n' "$srcrefs" | awk -F'\t' 'NR == FNR { skip[$0]; next } !($2 in skip)' <(printf '%s\n' "$skipped") -)
  local want=$kept; [[ -z $pfx ]] || want=$(printf '%s\n' "$kept" | add_prefix "$pfx")
  missing=$(comm -23 <(printf '%s\n' "$want" | sort) <(printf '%s\n' "$after" | sort))
  if [[ -n $missing ]]; then
    echo "FAIL $name: destination differs from source after push:" >&2
    printf '%s\n' "$missing" | sed 's/^/       /' >&2
    return 1
  fi
  local note=; [[ -z $skipped ]] || note=", $(printf '%s\n' "$skipped" | wc -l | tr -d ' ') merged branches left out"
  echo "ok   $name ($(printf '%s\n' "$kept" | wc -l | tr -d ' ') refs verified$note)"
}

# The HTTPS user name when none was set. Bitbucket access tokens log in as x-token-auth; the other hosts accept any name.
# Over SSH the name plays no part.
default_user() {
  if [[ $1 == http://* || $1 == https://* ]]; then parse_url "$1"; [[ $url_host == bitbucket.org ]] && { printf x-token-auth; return; }; fi
  printf x-access-token
}

run_pair() { # src dst [k=v ...]
  local src=$1 dst=$2; shift 2
  SRC_KEY=$D_SRC_KEY; DST_KEY=$D_DST_KEY; SRC_TOKEN_ENV=$D_SRC_TOKEN_ENV; DST_TOKEN_ENV=$D_DST_TOKEN_ENV
  SRC_USER=$D_SRC_USER; DST_USER=$D_DST_USER; DST_API_USER=$D_DST_API_USER; DST_PREFIX=$D_DST_PREFIX
  local kv
  for kv in "$@"; do
    case $kv in
      src_key=*) SRC_KEY=${kv#*=};; dst_key=*) DST_KEY=${kv#*=};;
      src_token_env=*) SRC_TOKEN_ENV=${kv#*=};; dst_token_env=*) DST_TOKEN_ENV=${kv#*=};;
      src_user=*) SRC_USER=${kv#*=};; dst_user=*) DST_USER=${kv#*=};; dst_api_user=*) DST_API_USER=${kv#*=};; dst_prefix=*) DST_PREFIX=${kv#*=};;
      *) echo "FAIL $src: unknown option '$kv' in pairs file" >&2; return 1;;
    esac
  done
  SRC_USER=${SRC_USER:-$(default_user "$src")}; DST_USER=${DST_USER:-$(default_user "$dst")}
  if [[ -n $DST_API_USER && $DST_USER == x-token-auth ]]; then
    echo "FAIL $src: an API token (dst_api_user) also needs dst_user set to the git user name for API tokens; x-token-auth is only for access tokens" >&2
    return 1
  fi
  sync_one "$src" "$dst"
}

dest_id() { parse_url "$1"; printf '%s %s' "$url_host" "$url_path"; }

# Pairs that would write into each other's refs are refused before anything runs.
check_pairs() {
  local -a ids=() pfxs=(); local line=0 src dst rest kv p i
  while read -r src dst rest; do
    line=$((line+1)); [[ -z $src || $src == \#* || -z $dst ]] && continue
    p=$D_DST_PREFIX
    for kv in $rest; do [[ $kv == dst_prefix=* ]] && p=${kv#*=}; done
    bad_prefix "$p" && { echo "  (line $line of $file)" >&2; exit 2; }
    ids+=("$(dest_id "$dst")"); pfxs+=("$p")
  done < "$file"
  local n=${#ids[@]} j
  for ((i=0; i<n; i++)); do for ((j=i+1; j<n; j++)); do
    [[ ${ids[i]} == "${ids[j]}" ]] || continue
    [[ -z ${pfxs[i]}${pfxs[j]} ]] && continue
    if [[ -z ${pfxs[i]} || -z ${pfxs[j]} || ${pfxs[i]}/ == "${pfxs[j]}/"* || ${pfxs[j]}/ == "${pfxs[i]}/"* ]]; then
      echo "two pairs write to the same destination with overlapping prefixes ('${pfxs[i]}' and '${pfxs[j]}'); they would overwrite each other" >&2
      exit 2
    fi
  done; done
}

failed=0
if [[ -n $file ]]; then
  check_pairs
  while read -r src dst rest; do
    [[ -z $src || $src == \#* ]] && continue
    if [[ -z $dst ]]; then echo "FAIL $src: line has no destination" >&2; failed=1; continue; fi
    # shellcheck disable=SC2086
    run_pair "$src" "$dst" $rest || failed=1
  done < "$file"
else
  run_pair "$1" "$2" || failed=1
fi
exit $failed
