#!/usr/bin/env bash
# git-sync: copy a repo's full history (all branches and tags) to another repo, and keep it in sync.
# Works between any git hosts. Re-running only transfers what changed.
#
# Usage:
#   git-sync [options] <source-url> <dest-url>
#   git-sync [options] -f <pairs-file>
#
# Pairs file: one pair per line, "# comments" and blank lines ignored:
#   <source-url> <dest-url> [src_key=PATH] [dst_key=PATH] [src_token_env=VAR] [dst_token_env=VAR] [src_user=U] [dst_user=U]
#   key = SSH private key file. token_env = NAME of an env var holding an HTTPS token (the file never holds secrets).
#
# Options:
#   --dry-run   fetch the source and simulate the push; changes nothing at the destination
#               (with --create and a missing destination it only checks that the repo can be created)
#   --force     allow a non-empty destination on the first run, and non-fast-forward updates
#   --prune     delete branches/tags at the destination that no longer exist at the source
#   --create    create the destination repo if it doesn't exist (private); GitHub via `gh`, Azure DevOps via `az`,
#               gitlab.com via its API (needs a token: --dst-token-env or dst_token_env=)
#   --public    with --create, make the new repo public (refused on Azure DevOps, where the project sets it)
#   --src-key P / --dst-key P / --src-token-env V / --dst-token-env V   default credentials for all pairs
#
# Env: GIT_SYNC_DIR (cache, default ~/.cache/git-sync), GIT_SYNC_{SRC,DST}_{KEY,TOKEN_ENV,USER} as defaults.
# Exit: 0 all pairs ok, 1 at least one pair failed, 2 bad usage.
set -uo pipefail
export GIT_TERMINAL_PROMPT=0

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

dry=0; force=0; prune=0; create=0; visibility=private; file=
D_SRC_KEY=${GIT_SYNC_SRC_KEY:-};  D_DST_KEY=${GIT_SYNC_DST_KEY:-}
D_SRC_TOKEN_ENV=${GIT_SYNC_SRC_TOKEN_ENV:-}; D_DST_TOKEN_ENV=${GIT_SYNC_DST_TOKEN_ENV:-}
D_SRC_USER=${GIT_SYNC_SRC_USER:-x-access-token}; D_DST_USER=${GIT_SYNC_DST_USER:-x-access-token}
while [[ ${1:-} == -* ]]; do
  case $1 in
    --dry-run) dry=1;; --force) force=1;; --prune) prune=1;; --create) create=1;; --public) visibility=public;;
    -f) file=${2:-}; shift;;
    --src-key) D_SRC_KEY=${2:-}; shift;; --dst-key) D_DST_KEY=${2:-}; shift;;
    --src-token-env) D_SRC_TOKEN_ENV=${2:-}; shift;; --dst-token-env) D_DST_TOKEN_ENV=${2:-}; shift;;
    *) usage;;
  esac; shift
done
if [[ -n $file ]]; then [[ $# -eq 0 && -f $file ]] || usage; else [[ $# -eq 2 ]] || usage; fi

cache_root=${GIT_SYNC_DIR:-$HOME/.cache/git-sync}
mkdir -p "$cache_root" || exit 1

# gitc <SRC|DST> <git args...>: run git with that side's credentials.
gitc() {
  local side=$1; shift
  local k=${side}_KEY t=${side}_TOKEN_ENV u=${side}_USER
  local -a pre=()
  if [[ -n ${!t:-} ]]; then
    pre=(-c credential.helper= -c "credential.helper=!f() { echo username=${!u}; echo \"password=\$${!t}\"; }; f")
  fi
  if [[ -n ${!k:-} ]]; then
    GIT_SSH_COMMAND="ssh -i ${!k} -o IdentitiesOnly=yes -o BatchMode=yes" git ${pre[@]+"${pre[@]}"} "$@"
  else
    git ${pre[@]+"${pre[@]}"} "$@"
  fi
}

parse_url() {
  local u=$1
  if [[ $u == *://* ]]; then
    u=${u#*://}; u=${u#*@}; url_host=${u%%/*}; url_host=${url_host%%:*}; url_path=${u#*/}
  else
    u=${u#*@}; url_host=${u%%:*}; url_path=${u#*:}
  fi
  url_path=${url_path#/}; url_path=${url_path%/}; url_path=${url_path%.git}
}

gh_dst() {
  ( export GH_HOST=github.com
    if [[ -n ${DST_TOKEN_ENV:-} ]]; then export GH_TOKEN=${!DST_TOKEN_ENV:-}; fi
    gh "$@" </dev/null )
}

dst_token_ok() {
  if [[ -n ${DST_TOKEN_ENV:-} && -z ${!DST_TOKEN_ENV:-} ]]; then
    echo "env var $DST_TOKEN_ENV is empty; the CLI would fall back to its own login and could create the repo in the wrong account" >&2
    return 1
  fi
}

# Returns 2 when the repo already exists, so a failed git read of it is an access problem, not a missing repo.
create_github() {
  command -v gh >/dev/null || { echo "gh is not installed" >&2; return 1; }
  [[ $1 == */* && $1 != */*/* ]] || { echo "cannot read owner/name from the URL" >&2; return 1; }
  dst_token_ok || return 1
  local err
  if err=$(gh_dst repo view "$1" 2>&1 >/dev/null); then return 2; fi
  [[ $err == *"Could not resolve to a Repository"* ]] ||
    { echo "gh could not check the repo (not logged in, bad token or no network)" >&2; return 1; }
  [[ $2 == check ]] && return 0
  gh_dst repo create "$1" "--$visibility" >/dev/null || return 1
}

az_dst() {
  ( if [[ -n ${DST_TOKEN_ENV:-} ]]; then export AZURE_DEVOPS_EXT_PAT=${!DST_TOKEN_ENV:-}; fi
    az "$@" </dev/null )
}

# Decodes only %XX sequences; anything else, including a lone % or a backslash, stays as written.
url_decode() {
  local s=$1 out= re='^([^%]*)%([0-9A-Fa-f]{2})(.*)$'
  while [[ $s =~ $re ]]; do
    out+=${BASH_REMATCH[1]}$(printf "\\x${BASH_REMATCH[2]}")
    s=${BASH_REMATCH[3]}
  done
  printf '%s' "$out$s"
}

# Same contract as create_github. Azure repos have no visibility of their own: it comes from the project.
create_azure() {
  command -v az >/dev/null || { echo "az is not installed" >&2; return 1; }
  [[ $visibility != public ]] || { echo "Azure DevOps repos follow the project's visibility; --public is not supported" >&2; return 1; }
  dst_token_ok || return 1
  local -a p; IFS=/ read -r -a p <<< "$1"
  local org proj repo
  if [[ ${#p[@]} -eq 4 && ${p[2]} == _git ]]; then org=${p[0]} proj=${p[1]} repo=${p[3]}
  elif [[ ${#p[@]} -eq 3 && ${p[1]} == _git ]]; then org=${p[0]} proj=${p[2]} repo=${p[2]}
  elif [[ ${#p[@]} -eq 4 && ${p[0]} == v3 ]]; then org=${p[1]} proj=${p[2]} repo=${p[3]}
  else echo "cannot read organization, project and repo from the URL" >&2; return 1; fi
  proj=$(url_decode "$proj"); repo=$(url_decode "$repo")
  visibility_note="set by the project"
  local orgurl=https://dev.azure.com/$org err
  if err=$(az_dst repos show --repository "$repo" --project "$proj" --organization "$orgurl" -o none 2>&1); then return 2; fi
  [[ $err != *TF200016* ]] ||
    { echo "Azure DevOps project '$proj' does not exist; --create makes repos, not projects, so create the project first" >&2; return 1; }
  [[ $err == *TF401019* ]] ||
    { echo "az could not check the repo (azure-devops extension missing, not logged in or bad PAT)" >&2; return 1; }
  [[ $2 == check ]] && return 0
  az_dst repos create --name "$repo" --project "$proj" --organization "$orgurl" -o none || return 1
}

# http_dst <auth-fn> <method> <url> [json]: curl with the credentials read from stdin, so no secret is ever on a command
# line. Sets http_code and http_body; http_code is 000 when curl itself failed.
http_dst() {
  local auth=$1 method=$2 url=$3 data=${4:-} out
  out=$( { "$auth"; printf 'url = "%s"\nrequest = "%s"\n' "$url" "$method"
           if [[ -n $data ]]; then
             printf 'header = "Content-Type: application/json"\n'
             data=${data//\\/\\\\}; printf 'data = "%s"\n' "${data//\"/\\\"}"
           fi
         } | curl -sS -m 30 -K - -w '\n%{http_code}' 2>/dev/null )
  http_code=${out##*$'\n'}; http_body=${out%$'\n'*}
  [[ $http_code =~ ^[0-9]{3}$ ]] || { http_code=000; http_body=; }
}

gitlab_auth() { printf 'header = "PRIVATE-TOKEN: %s"\n' "${!DST_TOKEN_ENV}"; }

# Same contract as create_github. Needs a token with the api scope in the DST_TOKEN_ENV variable.
create_gitlab() {
  [[ $1 == */* ]] || { echo "cannot read group/project from the URL" >&2; return 1; }
  [[ -n ${DST_TOKEN_ENV:-} && -n ${!DST_TOKEN_ENV:-} ]] ||
    { echo "--create on GitLab needs a token: set --dst-token-env (or dst_token_env=) to a variable holding one" >&2; return 1; }
  local api=https://gitlab.com/api/v4 ns=${1%/*} name=${1##*/}
  http_dst gitlab_auth GET "$api/projects/${1//\//%2F}"
  case $http_code in
    200) return 2;;
    404) ;;
    *) echo "GitLab answered $http_code when checking the repo (bad token, missing scope or no network)" >&2; return 1;;
  esac
  [[ $2 == check ]] && return 0
  http_dst gitlab_auth GET "$api/namespaces/${ns//\//%2F}"
  local nsid; nsid=$(printf '%s' "$http_body" | sed -n 's/^{"id":\([0-9][0-9]*\).*/\1/p')
  [[ $http_code == 200 && -n $nsid ]] || { echo "GitLab group or user '$ns' not found or not visible to the token" >&2; return 1; }
  http_dst gitlab_auth POST "$api/projects" "{\"name\":\"$name\",\"path\":\"$name\",\"namespace_id\":$nsid,\"visibility\":\"$visibility\"}"
  [[ $http_code == 201 ]] || { echo "GitLab answered $http_code when creating the repo" >&2; return 1; }
}

create_dest() {
  parse_url "$1"
  local host; host=$(ssh -G "$url_host" 2>/dev/null | awk '$1=="hostname"{print $2; exit}')
  case ${host:-$url_host} in
    github.com|ssh.github.com) create_github "$url_path" "$2";;
    dev.azure.com|ssh.dev.azure.com) create_azure "$url_path" "$2";;
    gitlab.com) create_gitlab "$url_path" "$2";;
    *) echo "--create does not support host '${host:-$url_host}' yet" >&2; return 1;;
  esac
}

# refs <SRC|DST> <url>: sorted "sha ref" lines for heads and tags, without peeled entries.
refs() {
  local out; out=$(gitc "$1" ls-remote --heads --tags "$2") || return 1
  [[ -z $out ]] || printf '%s
' "$out" | grep -v '\^{}$' | sort -k2
  return 0
}

sync_one() {
  local src=$1 dst=$2 name; name=$(basename "$src"); name=${name%.git}
  local id; id=$( { printf '%s\n%s' "$src" "$dst" | { shasum 2>/dev/null || sha1sum; }; } | cut -c1-12)
  local cache=$cache_root/$id.git first=0
  [[ -d $cache ]] || first=1

  local srcrefs dstrefs
  srcrefs=$(refs SRC "$src") || { echo "FAIL $name: cannot read source (auth, URL or network)" >&2; return 1; }
  [[ -n $(printf '%s\n' "$srcrefs" | grep 'refs/heads/') ]] ||
    { echo "FAIL $name: source has no branches; refusing to continue" >&2; return 1; }
  if ! dstrefs=$(refs DST "$dst"); then
    if (( create )); then
      visibility_note=$visibility; create_dest "$dst" check; local rc=$?
      (( rc == 2 )) && { echo "FAIL $name: destination exists but cannot be read (auth)" >&2; return 1; }
      (( rc == 0 )) || { echo "FAIL $name: cannot create destination" >&2; return 1; }
      if (( dry )); then echo "ok   $name (dry run: destination missing, would create it, visibility: $visibility_note)"; return 0; fi
      create_dest "$dst" create || { echo "FAIL $name: could not create destination" >&2; return 1; }
      dstrefs=$(refs DST "$dst") || { echo "FAIL $name: created destination but cannot read it (auth)" >&2; return 1; }
    else
      echo "FAIL $name: cannot read destination (auth, URL or repo missing; --create makes a missing one)" >&2; return 1
    fi
  fi
  if (( first && force == 0 )) && [[ -n $dstrefs ]]; then
    echo "FAIL $name: destination already has refs and this pair was never synced here; rerun with --force to adopt it" >&2
    return 1
  fi

  (( first )) && { git init --bare -q "$cache" || return 1; git -C "$cache" config gc.auto 0; }

  gitc SRC -C "$cache" fetch -q --no-tags --prune "$src" \
    '+refs/heads/*:refs/heads/*' '+refs/tags/*:refs/tags/*' ||
    { echo "FAIL $name: fetch failed" >&2; return 1; }

  local -a flags=()
  (( force )) && flags+=(--force); (( prune )) && flags+=(--prune); (( dry )) && flags+=(--dry-run)
  gitc DST -C "$cache" push -q ${flags[@]+"${flags[@]}"} "$dst" \
    'refs/heads/*:refs/heads/*' 'refs/tags/*:refs/tags/*' ||
    { echo "FAIL $name: push failed (rejected refs need --force; read-only credentials also land here)" >&2; return 1; }

  if (( dry )); then echo "ok   $name (dry run: fetched, push simulated, nothing changed)"; return 0; fi

  local after missing
  after=$(refs DST "$dst") || { echo "FAIL $name: pushed, but could not re-read destination to verify" >&2; return 1; }
  missing=$(comm -23 <(printf '%s\n' "$srcrefs") <(printf '%s\n' "$after"))
  if [[ -n $missing ]]; then
    echo "FAIL $name: destination differs from source after push:" >&2
    printf '%s\n' "$missing" | sed 's/^/       /' >&2
    return 1
  fi
  echo "ok   $name ($(printf '%s\n' "$srcrefs" | wc -l | tr -d ' ') refs verified)"
}

run_pair() { # src dst [k=v ...]
  local src=$1 dst=$2; shift 2
  SRC_KEY=$D_SRC_KEY; DST_KEY=$D_DST_KEY; SRC_TOKEN_ENV=$D_SRC_TOKEN_ENV; DST_TOKEN_ENV=$D_DST_TOKEN_ENV
  SRC_USER=$D_SRC_USER; DST_USER=$D_DST_USER
  local kv
  for kv in "$@"; do
    case $kv in
      src_key=*) SRC_KEY=${kv#*=};; dst_key=*) DST_KEY=${kv#*=};;
      src_token_env=*) SRC_TOKEN_ENV=${kv#*=};; dst_token_env=*) DST_TOKEN_ENV=${kv#*=};;
      src_user=*) SRC_USER=${kv#*=};; dst_user=*) DST_USER=${kv#*=};;
      *) echo "FAIL $src: unknown option '$kv' in pairs file" >&2; return 1;;
    esac
  done
  sync_one "$src" "$dst"
}

failed=0
if [[ -n $file ]]; then
  while read -r src dst rest; do
    [[ -z $src || $src == \#* ]] && continue
    if [[ -z $dst ]]; then echo "FAIL $src: line has no destination" >&2; failed=1; continue; fi
    # shellcheck disable=SC2086
    run_pair "$src" "$dst" $rest || failed=1
  done < "$file"
else
  run_pair "$1" "$2" || failed=1
fi
exit $failed
